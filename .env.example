APP_NAME=Rental Management
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# Google OAuth (Sign in with Google / Gmail)
# ---------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services → OAuth consent screen → configure "External" app,
#    add your email as a test user.
# 3. APIs & Services → Credentials → Create Credentials → OAuth client ID.
#    Application type: Web application.
#    Authorized redirect URI:  https://YOUR-DOMAIN/auth/google/callback
#    (for local dev:           http://localhost:8000/auth/google/callback)
# 4. Copy the Client ID + Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the absolute URL (must match what you set in Google Cloud exactly):
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# Mail (SMTP) — used for invoice / payment / maintenance notifications.
# For free transactional email, sign up at https://brevo.com (formerly Sendinblue)
# or https:// resend.com and paste the SMTP credentials below.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional — Resend (https://resend.com) gives 3,000 free emails/month
RESEND_KEY=

# Optional — Stripe (for future online rent payments). Leave empty if unused.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
